# Choose one provider:
OPENAI_API_KEY=your_key_here

# 第三方 / 自建「OpenAI 兼容」API 的 base（路径通常含 /v1）
# 示例：https://api.openai.com/v1  或 你的转发服务根地址
# 不要把这个填进 OPENAI_HTTP_PROXY
OPENAI_BASE_URL=

# 仅「本地 HTTP 代理」：Clash / v2rayN 的 HTTP 端口（常见 7890）
# 必须是 http://127.0.0.1:端口 这种「代理隧道」，不能填上面的 API 网址
OPENAI_HTTP_PROXY=http://127.0.0.1:7890

# Deepseek example (if you use it later)
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Runtime options
PROVIDER=openai
MODEL_NAME=gpt-4o-mini

# --- RAG 知识库（可选）---
# 向量索引与分块文件存放目录（相对项目根）
KB_DATA_DIR=data/kb
# 向量模型（需与 OpenAI 兼容的 embeddings 接口）
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 若 Embedding 与 Chat 使用不同 Key/Base，可单独填；否则默认沿用 OPENAI_*
EMBEDDING_OPENAI_API_KEY=
EMBEDDING_OPENAI_BASE_URL=
