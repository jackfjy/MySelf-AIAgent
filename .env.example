# Choose one provider:
OPENAI_API_KEY=sk-

# 仅当 PROVIDER=openai 时生效：走 HTTP/HTTPS 代理访问 OpenAI API（示例为常见本地端口）
# 形如：http://127.0.0.1:7890  或  http://user:pass@host:port
OPENAI_HTTP_PROXY=https://api.openai-proxy.org/v1

# Deepseek example (if you use it later)
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Runtime options
PROVIDER=openai
MODEL_NAME=gpt-4o-mini
